{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsl/menu.v1.json",
  "title": "menu v1",
  "type": "object",
  "required": [
    "v",
    "type",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "const": "menu"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "items"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "banner": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name",
              "price"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "price": {
                "type": "string",
                "description": "String, not a number \u2014 parsed with int.tryParse at render time (menu_handler.dart:484). Do not change to a numeric type without a v2 migration."
              },
              "image": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
