{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsl/banner.v1.json",
  "title": "banner v1",
  "type": "object",
  "required": [
    "v",
    "type",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "const": "banner"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "title",
        "message"
      ],
      "properties": {
        "variant": {
          "type": "string",
          "description": "Confirmed optional via test/dsl/banner_handler_test.dart (defaults to 'info'). Observed values so far: outage, success \u2014 not a closed enum, banner is meant to render arbitrary agent content per the same test file."
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "meta": {
          "type": "string",
          "description": "Confirmed optional via test."
        }
      }
    }
  }
}
